# Copy to .env and adjust. Anything missing or empty uses the default from
# server/flightpanel/config.py (BER). Keep .env private: it can contain credentials.
#
# Only server settings go here. Everything that belongs to a single panel (location,
# view field, display, brightness, quiet hours, idle cards) lives in data/flightpanel.db
# and is set after start-up:
#   docker compose exec flightpanel python3 -m flightpanel.panels keys           # all, with defaults
#   docker compose exec flightpanel python3 -m flightpanel.panels set home HOME_LAT=52.52 HOME_LON=13.40
# Full reference: docs/configuration.md

# --- Home airport ---
# IATA code. Position, elevation and METAR station come from data/airports.json; set AIRPORT_LAT,
# AIRPORT_LON, AIRPORT_ALT_M and METAR_STATION (ICAO code) only for an airport missing there.
LOCAL_AIRPORT_IATA=BER
# AIRPORT_LAT=52.3617
# AIRPORT_LON=13.5023
# AIRPORT_ALT_M=48
# METAR_STATION=EDDB
# Final approach course of one landing direction, for landing sequence and direction
# (BER 25 = 249°, MUC 26 = 263°); the opposite direction follows.
RUNWAY_COURSE=249
# Night flight ban at the airport (BER: 0:00 to 5:00), for the "curfew" card
CURFEW_HOURS=00:00-05:00
# Weather (METAR) for the cloud, fog and thunderstorm cards and the wind on the runway card
METAR=1

# --- Data sources ---
# MOCK=1 shows fictional flights, no network needed. For designing layouts and testing hardware.
MOCK=1
# adsblol: community network (ADS-B + MLAT), no account and no daily limit, also provides
# type and category; if it fails, OpenSky takes over. opensky: OpenSky only.
SOURCE=adsblol
# Seconds between fetches (OpenSky: longer, if the daily budget would not last otherwise)
POLL_INTERVAL=20
# Routes: adsb.im first (more current), then adsbdb. If neither knows the flight, the
# origin airport comes from the OpenSky track (where it starts on the ground). 0 disables.
ADSBIM=1
TRACK_ORIGIN=1
# OpenSky account -> API Clients -> create a new client. Without: anonymous, 400 credits
# a day (enough as a fallback source).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# ISS orbit data from CelesTrak (once a day), for the "iss" card
ISS=1

# --- Display (2 x Waveshare P2.5 64x32 side by side); must match firmware/include/config.h ---
WIDTH=128
HEIGHT=32

# --- Logos ---
# Missing logos are fetched the first time an airline appears and stored in data/logos/.
# Only roughly square logo marks (up to LOGO_MAX_ASPECT); wordmarks are unreadable at
# 32 x 32, the placeholder is shown instead. Subsidiaries show the brand's logo: logo
# code in data/airlines.json (KLM Cityhopper -> KL). Your own logos
# (tools/make_logo.py, stored in data/logos/own/) take precedence over fetched ones.
LOGO_FETCH=1
LOGO_SIZE=32
LOGO_MAX_ASPECT=1.5
# Own sources, comma-separated, with {iata} or {icao}, optionally |aspect ratio.
# Empty = Kiwi.com, FlightAware, Google (logos.DEFAULT_URLS).
# LOGO_URLS=https://images.kiwi.com/airlines/128x128/{iata}.png,https://www.flightaware.com/images/airline_logos/90p/{icao}.png

# --- Operation ---
# Linux: user and group that own data/ (id -u, id -g); the container runs as them (default 1000:1000)
# PUID=1000
# PGID=1000

# Time zone for quiet hours, daily statistics and clock
TZ=Europe/Berlin
# LAN port for preview and panel inside the container. Leave it at 8080: compose.yml and the image's health
# check expect it. For another port on the host, change the left side of "ports:" in compose.yml instead.
# Home network only: it has no login (docs/configuration.md).
HTTP_PORT=8080
LOG_LEVEL=INFO
# The panel on the LAN port (:8080); the server creates it at first start
# LAN_PANEL=home
# Additional panels (docker compose exec flightpanel python3 -m flightpanel.panels add …): their window at most this far from the airport,
# their fetch radius (RADIUS_KM, SCAN_RADIUS_KM) at most this large. One fetch covers all panels.
# PANEL_MAX_KM=60
# PANEL_MAX_RADIUS_KM=80
# Without fresh data: dimmed after STALE_AFTER seconds, blank after EMPTY_AFTER
# STALE_AFTER=120
# EMPTY_AFTER=600
# Host names the LAN port answers to besides IP addresses, localhost, names without a dot and names
# ending in .local, .home.arpa and .internal (protection against DNS rebinding), comma-separated. The name
# your router hands out belongs here too: if a panel's setup portal has e.g. http://nas.fritz.box:8080 as
# server address (docs/hardware.md), set LAN_HOSTS=nas.fritz.box, otherwise the panel gets 421.
# LAN_HOSTS=
# Settings page /settings for the LAN panel (location, view field, calibration at the window)
# SETTINGS_PAGE=1

# --- Remote panels via Cloudflare Access, see docs/remote-panels.md ---
# All four or none. Without them none of this runs.
# PUBLIC_PORT=8081
# ACCESS_TEAM=
# ACCESS_AUD=
# PUBLIC_HOST=

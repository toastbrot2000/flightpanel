# Eigene Einstellungen (Standort!) und Zugangsdaten
.env
firmware/include/secrets.h
firmware/platformio_local.ini

# Im Betrieb erzeugt (Docker-Volume ./data)
data/flightpanel.db*
# Kopien der Datenbank unter anderem Namen (panels backup, nächtliche Kopie): Standort und Album
data/*.db
data/*.db-*
data/*.db.*
data/*.bak
data/*.imported
data/cache.json
data/issues.json
data/stats.json
data/tle.txt
data/*.tmp
data/*.log
# Logos sind Marken der Airlines: Der Server holt sie selbst, auch handgemachte bleiben lokal
data/logos/*

# Werkzeuge
firmware/.pio/
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Zugang von außen für Freunde (docs/freunde.md): die eigene Compose-Ergänzung (Domain, Tunnel) und der Token des Tunnels
compose.override.yml
cloudflared.env

# Worktrees von Claude-Code-Sitzungen (eigene Git-Repos, nie einchecken)
.claude/worktrees/

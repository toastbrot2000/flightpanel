# Kopieren nach .env und ausfüllen.

# --- Standort und Filter ---
HOME_LAT=52.5xxx
HOME_LON=13.5xxx
RADIUS_KM=40
MAX_ALT_M=6000
LOCAL_AIRPORT_IATA=BER

# --- Datenquellen ---
# MOCK=1 zeigt Fantasieflüge, ohne OpenSky. Zum Layout-Entwerfen und für den Hardwaretest.
MOCK=1
# OpenSky-Account -> API Clients -> neuen Client anlegen. Ohne Zugangsdaten: anonym, 400 Credits/Tag.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
POLL_INTERVAL=30

# --- Anzeige (2 x Waveshare P2.5 64x32 nebeneinander) ---
WIDTH=128
HEIGHT=32
# auto: C wenn ein Logo da ist, sonst A.  A: ein Flug ohne Logo.  B: zwei Flüge.  C: Logo + drei Zeilen.
LAYOUT=auto
PAGE_SECONDS=4
MAX_FLIGHTS=2

# --- Logos ---
# Fehlende Logos werden beim ersten Auftauchen einer Airline per IATA-Code geholt und in data/logos/ abgelegt.
LOGO_FETCH=1
LOGO_SIZE=30
# LOGO_URL=https://pics.avs.io/200/200/{code}.png

# --- Helligkeit (0-255, der ESP32 deckelt zusätzlich bei MAX_BRIGHTNESS) ---
# HUB75 ist hell: 90 tagsüber ist im Wohnzimmer schon viel.
BRIGHTNESS_DAY=90
BRIGHTNESS_EVENING=35
DAY_HOURS=08:00-19:00
QUIET_HOURS=23:00-06:30
TZ=Europe/Berlin

# --- Betrieb ---
HTTP_PORT=8080
LOG_LEVEL=INFO

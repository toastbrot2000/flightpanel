# Kopieren nach .env und ausfüllen.

# --- Standort und Filter ---
# Eigene Koordinaten eintragen (Dezimalgrad, Punkt). Der Wert hier ist Berlin-Mitte.
HOME_LAT=52.52
HOME_LON=13.40
RADIUS_KM=40
MAX_ALT_M=6000
LOCAL_AIRPORT_IATA=BER

# --- Sichtfeld: was man vom Fenster aus sieht ---
# Flugzeuge im Sichtfeld kommen zuerst, Airlines vor Privatflügen und Hubschraubern.
# Richtung im Uhrzeigersinn von VIEW_FROM bis VIEW_TO in Grad (0 = Nord, 90 = Ost,
# 180 = Süd, 270 = West), 0 bis 360 = rundum. VIEW_MIN_ELEV: Mindesthöhe über dem
# Horizont in Grad (Häuser, Bäume). VIEW_MAX_ELEV: z. B. der Balkon darüber.
# Eichen: /display.json -> "nearby" zeigt für jedes Flugzeug Richtung (az) und
# Höhenwinkel (elev). Ein Flugzeug am Fenster suchen und die Werte vergleichen.
HOME_ALT_M=40
VIEW_FROM=0
VIEW_TO=360
VIEW_MIN_ELEV=0
VIEW_MAX_ELEV=90
VIEW_MAX_KM=100
# 1: nur was im Sichtfeld ist (oder bis zum nächsten Abruf hineinfliegt), sonst Uhr.
# 0: Sichtbares zuerst, sonst das nächste Flugzeug im Radius.
VIEW_ONLY=0
# Privatflüge, Hubschrauber, Polizei, Militär: 1 = zeigen, wenn keine Airline dran ist, 0 = nie.
SHOW_OTHER=1

# --- Datenquellen ---
# MOCK=1 zeigt Fantasieflüge, ohne OpenSky. Zum Layout-Entwerfen und für den Hardwaretest.
MOCK=1
# OpenSky-Account -> API Clients -> neuen Client anlegen. Ohne Zugangsdaten: anonym,
# 400 Credits/Tag, dann pollt der Server automatisch nur alle ~2,5 min statt alle 30 s.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Mindestabstand in Sekunden; wird verlängert, wenn das Tagesbudget sonst nicht reicht.
POLL_INTERVAL=30

# --- Anzeige (2 x Waveshare P2.5 64x32 nebeneinander) ---
WIDTH=128
HEIGHT=32
# auto: C wenn ein Logo da ist, sonst A.  A: ein Flug ohne Logo.  B: zwei Flüge.  C: Logo + drei Zeilen.
LAYOUT=auto
PAGE_SECONDS=4
MAX_FLIGHTS=2

# --- Logos ---
# Fehlende Logos werden beim ersten Auftauchen einer Airline geholt und in data/logos/ abgelegt.
# Nur annähernd quadratische Bildmarken, Schriftzüge sind bei 30 x 30 unlesbar (dann Layout A).
LOGO_FETCH=1
LOGO_SIZE=30
LOGO_MAX_ASPECT=1.5
# Eigene Quellen, kommagetrennt, {iata} oder {icao}. Leer = Kiwi.com, dann FlightAware.
# LOGO_URLS=https://images.kiwi.com/airlines/128x128/{iata}.png,https://www.flightaware.com/images/airline_logos/90p/{icao}.png

# --- Helligkeit (0-255, der ESP32 deckelt zusätzlich bei MAX_BRIGHTNESS) ---
# HUB75 ist hell: 90 tagsüber ist im Wohnzimmer schon viel.
BRIGHTNESS_DAY=90
BRIGHTNESS_EVENING=35
DAY_HOURS=08:00-19:00
QUIET_HOURS=23:00-06:30
TZ=Europe/Berlin

# --- Betrieb ---
HTTP_PORT=8080
LOG_LEVEL=INFO

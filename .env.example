# Kopieren nach .env und anpassen. Was fehlt oder leer ist, hat den Default aus
# server/flightpanel/config.py (Berlin, BER). Die .env steht nicht im Repo: Sie
# enthält den eigenen Standort.

# --- Standort ---
# Eigene Koordinaten (Dezimalgrad, Punkt); der Wert hier ist Berlin-Mitte.
HOME_LAT=52.52
HOME_LON=13.40
# Augenhöhe am Fenster über dem Meer, in Metern (Gelände plus Stockwerk)
HOME_ALT_M=40
# Angezeigt wird, was höchstens so weit weg und so hoch ist
RADIUS_KM=40
MAX_ALT_M=6000
# Abrufradius für Tagesstatistik, seltene Flugzeuge und Notfall-Squawks; angezeigt
# wird trotzdem nur RADIUS_KM. Leer = wie RADIUS_KM.
SCAN_RADIUS_KM=80

# --- Sichtfeld: was man vom Fenster aus sieht ---
# Flugzeuge im Sichtfeld kommen zuerst. Richtung im Uhrzeigersinn von VIEW_FROM bis
# VIEW_TO in Grad (0 = Nord, 90 = Ost, 180 = Süd, 270 = West); 0 bis 360 = rundum.
# VIEW_MIN_ELEV: Mindesthöhe über dem Horizont in Grad (Häuser, Bäume),
# VIEW_MAX_ELEV: Obergrenze (z. B. der Balkon darüber), VIEW_MAX_KM: Sichtweite.
# Eichen: ein Flugzeug am Fenster suchen und in /display.json unter "nearby" dessen
# Richtung (az) und Höhenwinkel (elev) ablesen.
VIEW_FROM=0
VIEW_TO=360
VIEW_MIN_ELEV=0
VIEW_MAX_ELEV=90
VIEW_MAX_KM=100
# 1: nur zeigen, was im Sichtfeld ist (oder bis zum nächsten Abruf hineinfliegt).
# 0: Sichtbares zuerst, sonst das nächste Flugzeug im Radius.
VIEW_ONLY=0
# Privatflieger, Hubschrauber, Polizei, Militär: 1 = zeigen, wenn keine Airline dran ist.
SHOW_OTHER=1

# --- Heimatflughafen ---
# IATA-Code. Position und METAR-Station kommen aus data/airports.json; nur für einen
# Flughafen, der dort fehlt, AIRPORT_LAT und AIRPORT_LON setzen (METAR_STATION = ICAO).
LOCAL_AIRPORT_IATA=BER
# AIRPORT_LAT=52.3617
# AIRPORT_LON=13.5023
# METAR_STATION=EDDB
AIRPORT_ALT_M=48
# Kurs im Endanflug einer Landerichtung, für Landefolge und Landerichtung
# (BER 25 = 249°, MUC 26 = 263°); die Gegenrichtung ergibt sich.
RUNWAY_COURSE=249
# Nachtflugverbot am Flughafen (BER: 0 bis 5 Uhr), für die Karte "curfew"
CURFEW_HOURS=00:00-05:00
# Wetter (METAR) für Wolken-, Nebel-, Gewitterkarten und den Wind auf der Pistenkarte
METAR=1

# --- Datenquellen ---
# MOCK=1 zeigt Fantasieflüge, ohne Netz. Zum Layout-Entwerfen und für den Hardwaretest.
MOCK=1
# adsblol: Community-Netz (ADS-B + MLAT), ohne Account und ohne Tageslimit, liefert
# auch Typ und Kategorie; fällt es aus, springt OpenSky ein. opensky: nur OpenSky.
SOURCE=adsblol
# Sekunden zwischen zwei Abrufen (OpenSky: länger, wenn das Tagesbudget sonst nicht reicht)
POLL_INTERVAL=20
# Routen: adsb.im zuerst (aktueller), dann adsbdb. Kennt keine den Flug, kommt der
# Abflughafen aus der OpenSky-Flugspur (wo sie am Boden beginnt). 0 schaltet ab.
ADSBIM=1
TRACK_ORIGIN=1
# OpenSky-Account -> API Clients -> neuen Client anlegen. Ohne: anonym, 400 Credits
# am Tag (als Ersatzquelle reicht das).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Anzeige (2 x Waveshare P2.5 64x32 nebeneinander) ---
WIDTH=128
HEIGHT=32
# auto: C mit Logo, sonst A.  A: ohne Logo.  B: zwei Flüge, je eine Zeile.  C: Logo + drei Zeilen.
LAYOUT=auto
PAGE_SECONDS=4
# So viele Flüge wechseln sich ab (je drei bis vier Infoseiten à PAGE_SECONDS)
MAX_FLIGHTS=3

# --- Leerlauf-Karten: wenn keine Airline im Sichtfeld ist ---
# Alle IDLE_SECONDS die nächste Karte, in festen Stufen (docs/screens.md); die Uhr
# kommt in etwa IDLE_CLOCK_SHARE der Fälle. Jede Karte lässt sich abschalten:
# CARD_<ID>=0. Hat keine eingeschaltete Karte etwas zu zeigen, bleibt das Panel dunkel.
IDLE_SECONDS=12
IDLE_CLOCK_SHARE=0.35
# Notfall-Squawk 7700/7600/7500 in der Nähe: vor allem anderen, auch vor Flügen
CARD_ALERT=1
# Stufe 2, Verkehr am Platz: Abflüge (rollt, startet), die nächsten Landungen mit
# Minuten, wer als nächstes ins Sichtfeld kommt, Privatflieger/Hubschrauber/Polizei/
# Militär im Sichtfeld, Pistenwechsel
CARD_DEPARTURES=1
CARD_ARRIVALS=1
CARD_NEXT=1
CARD_PRIVATE=1
CARD_RUNWAY_CHANGE=1
# Stufe 3, wenig los: Radar, Landerichtung und Wind, Wetter (warum der Himmel leer
# ist), Nachtflugverbot, Tagesstatistik, Sammelalbum, neue Airline, seltene Flugzeuge
# (data/rare.json), Flaute, ISS-Überflug, Sonnenauf- und -untergang, Uhr,
# Weihnachten und Silvester
CARD_RADAR=1
CARD_RUNWAY=1
CARD_WEATHER=1
CARD_CURFEW=1
CARD_SCOREBOARD=1
CARD_POKEDEX=1
CARD_NEW=1
CARD_RARE=1
CARD_QUIET=1
CARD_ISS=1
CARD_SUNSET=1
CARD_SUNRISE=1
CARD_CLOCK=1
CARD_SANTA=1
CARD_FIREWORKS=1
# Stufe 4, nur wenn gar nichts los ist: Witze, Verspätungsgründe, Sprüche
# (data/jokes.json, gilt nur für den Flughafen, für den sie geschrieben ist),
# Flugzeug- und Taubenanimation; Tegel und BER-Eröffnung nur am BER
CARD_JOKE=1
CARD_DELAY=1
CARD_PLANE=1
CARD_PIGEON=1
CARD_TXL=1
CARD_BER_OPENING=1
# ISS-Bahndaten von Celestrak (einmal am Tag), für die Karte "iss"
ISS=1

# --- Logos ---
# Fehlende Logos werden beim ersten Auftauchen einer Airline geholt und in data/logos/
# abgelegt. Nur annähernd quadratische Bildmarken (bis LOGO_MAX_ASPECT); Schriftzüge
# sind bei 32 x 32 unlesbar, dann Layout A ohne Logo.
LOGO_FETCH=1
LOGO_SIZE=32
LOGO_MAX_ASPECT=1.5
# Eigene Quellen, kommagetrennt, {iata} oder {icao}, optional |Seitenverhältnis.
# Leer = Kiwi.com, FlightAware, Google (logos.DEFAULT_URLS).
# LOGO_URLS=https://images.kiwi.com/airlines/128x128/{iata}.png,https://www.flightaware.com/images/airline_logos/90p/{icao}.png

# --- Helligkeit (0-255; der ESP32 deckelt zusätzlich bei MAX_BRIGHTNESS) ---
# HUB75 ist hell: 90 tagsüber ist im Wohnzimmer schon viel. In den QUIET_HOURS ist
# das Panel schwarz und es wird nicht abgerufen.
BRIGHTNESS_DAY=90
BRIGHTNESS_EVENING=35
DAY_HOURS=08:00-19:00
QUIET_HOURS=23:00-06:30
TZ=Europe/Berlin

# --- Betrieb ---
HTTP_PORT=8080
LOG_LEVEL=INFO
# Ohne frische Daten: nach STALE_AFTER Sekunden gedimmt, nach EMPTY_AFTER leer
# STALE_AFTER=120
# EMPTY_AFTER=600

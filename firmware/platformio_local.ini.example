; Local PlatformIO settings, for this machine only (platformio_local.ini is listed in .gitignore).
;
;   cp platformio_local.ini.example platformio_local.ini
;
; platformio.ini reads the file via extra_configs if it exists; without it the
; firmware still builds. It is only needed for uploading over Wi-Fi:
;
;   pio run -e esp32dev_ota -t upload
;
; The password must match OTA_PASSWORD in include/secrets.h. If that is empty, the panel
; runs no OTA and there is nothing to upload to.
;
; Letters and digits are simplest. Don't use "%" (PlatformIO then rejects the whole
; configuration, including normal builds) or "${" (gets substituted). After a space,
; ";" and "#" start a comment.
; Run pio inside the firmware/ folder; that is where the file is looked for.

[env:esp32dev_ota]
upload_flags =
    --auth=HIER_DAS_OTA_PASSWORT

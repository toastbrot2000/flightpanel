#pragma once
// Freiwillig, für den eigenen Prüfstand: Vorgaben, solange das Panel nichts Eigenes gespeichert hat, und das
// OTA-Passwort. Ohne diese Datei öffnet ein frisch geflashtes Panel sein Einrichtungs-WLAN; so bekommen Freunde
// die Firmware. Was dort gespeichert wird, gilt vor diesen Vorgaben (Zurücksetzen bringt sie wieder).
// Kopieren nach include/secrets.h (steht in .gitignore); nicht Gebrauchtes löschen.

#define WIFI_SSID     "mein-wlan"                  // 2,4 GHz! Der ESP32 kann kein 5 GHz.
#define WIFI_PASS     "geheim"
#define SERVER_URL    "http://192.168.1.10:8080"   // Server im Heimnetz, ohne /frame
#define HOSTNAME      "flightpanel"                // Name im Router; mit OTA auch flightpanel.local
#define OTA_PASSWORD  ""                           // leer = kein OTA. Sonst dasselbe Passwort in platformio_local.ini
// Nur für https über Cloudflare Access (Service-Token), sonst weglassen:
// #define ACCESS_CLIENT_ID      "....access"
// #define ACCESS_CLIENT_SECRET  "..."

# Your own settings (location!) and credentials
.env
firmware/include/secrets.h
firmware/include/fw_pubkey.h
firmware/platformio_local.ini

# Generated at runtime (Docker volume ./data)
data/flightpanel.db*
# Database copies under other names (panels backup, nightly copy): location and album
data/*.db
data/*.db-*
data/*.db.*
data/*.bak
data/*.tmp
data/*.log
# Files of older versions (imported into the database at first start)
data/*.imported
data/cache.json
data/issues.json
data/stats.json
data/tle.txt
# Logos are airline trademarks: the server fetches them itself, hand-made ones stay local too
data/logos/*
# Firmware releases (tools/fw_release.sh): signed images belong on the server, not in the repository
data/firmware/

# Tools
firmware/.pio/
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Remote panels (docs/remote-panels.md): your compose override (domain, tunnel) and the tunnel token
compose.override.yml
cloudflared.env

# Private deployment to the owner's cluster (hostnames, cluster layout)
homelab/

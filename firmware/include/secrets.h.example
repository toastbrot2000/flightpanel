#pragma once
// Optional, for your own bench panel: defaults used as long as the panel has nothing stored, and the OTA password.
// Without this file a freshly flashed panel opens its setup Wi-Fi; that is how panels for other people are built.
// Values saved in the setup portal take precedence over these defaults (a reset brings them back).
// Copy to include/secrets.h (listed in .gitignore); delete what you don't need.

#define WIFI_SSID     "mein-wlan"                  // 2.4 GHz! The ESP32 has no 5 GHz.
#define WIFI_PASS     "geheim"
#define SERVER_URL    "http://192.168.1.10:8080"   // server on your home network, without /frame
#define HOSTNAME      "flightpanel"                // name in the router; with OTA also flightpanel.local
#define OTA_PASSWORD  ""                           // empty = no OTA. Otherwise the same password in platformio_local.ini
// Only for https via Cloudflare Access (service token), otherwise leave out:
// #define ACCESS_CLIENT_ID      "....access"
// #define ACCESS_CLIENT_SECRET  "..."

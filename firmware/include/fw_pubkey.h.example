#pragma once
// Public key for signed firmware updates (ECDSA P-256).
//
// Copy to include/fw_pubkey.h (listed in .gitignore) and replace the placeholder below with your own public key.
// If fw_pubkey.h exists, the firmware includes the update check (src/fwsig.cpp); without it, the panel accepts no
// updates from the server. Full instructions: docs/hardware.md, section 7, "Signed firmware updates".
//
// Create the key pair once, outside the repository and outside any synced folder (OneDrive, Dropbox,
// iCloud ...). openssl asks for a passphrase, which you will type at every release:
//
//   mkdir -p ~/flightpanel-signing
//   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -aes-256-cbc -out ~/flightpanel-signing/fw_signing.pem
//   openssl pkey -in ~/flightpanel-signing/fw_signing.pem -pubout
//
// The output of the last command, from BEGIN PUBLIC KEY to END PUBLIC KEY, replaces the three placeholder lines.
// Never paste the private key: every firmware.bin is public. If PRIVATE appears here, the build fails.
//
// With the placeholder the firmware builds but accepts no update (the key is unreadable), and
// tools/fw_release.sh refuses every release: the signature doesn't match this key.

static constexpr char FW_PUBKEY_PEM[] = R"PEM(
-----BEGIN PUBLIC KEY-----
HIER-DEN-EIGENEN-OEFFENTLICHEN-SCHLUESSEL-EINSETZEN
-----END PUBLIC KEY-----
)PEM";
